# Copy to .env and adjust. .env is gitignored; this file is the tracked
# reference for it.
#
#     cp .env.example .env
#
# Paths are relative to the repository root, which is the working
# directory both `docker compose` and `pnpm dev` run from.

# ---------------------------------------------------------------------
# Shared -- used by `docker compose up` AND `pnpm dev`
# ---------------------------------------------------------------------

# Required. The password that unlocks the web UI. Compose refuses to
# start without it (see compose.yaml), and the backend throws on boot.
APP_PASSWORD=choose-something

# ---------------------------------------------------------------------
# Dev mode only -- `pnpm dev`
#
# Compose passes ONLY APP_PASSWORD into the container (see the
# `environment:` block in compose.yaml), so everything below is ignored
# by Docker. The image sets its own values via ENV in docker/Dockerfile.
# ---------------------------------------------------------------------

# Where config.json, history.db and the cookie pickles are written. Kept
# out of ./data so a dev run never touches the volume Docker mounts.
DATA_DIR=./.devdata

# The Python helpers (state.py, login.py) and the miner entry point.
PYTHON_DIR=./python

# Must be the uv-managed venv, not the system python3 (the default),
# which lacks the miner's dependencies. Create it with `uv sync`.
PYTHON_BIN=./.venv/bin/python

# The built frontend. In dev mode you normally load the Vite dev server
# instead (it proxies /api here), so this only matters if you open the
# backend's port directly after a `pnpm -r build`.
STATIC_ROOT=./apps/frontend/dist

# Backend listen port. Vite's proxy in apps/frontend/vite.config.ts
# targets 8080, so change both together.
PORT=8080

# How long (ms) to wait for a SIGTERM'd miner to exit before sending
# SIGKILL. Defaults to 20000.
#
# Upstream's shutdown joins background threads that sleep on long
# intervals, so the miner routinely takes ~15s to exit. `node --watch`
# waits for the old process before restarting, which makes every backend
# edit in `pnpm dev` cost that full delay. Lowering this trades the
# miner's clean exit (its end-of-session report, and releasing the Twitch
# session promptly) for a fast restart -- fine in dev, not in production.
MINER_STOP_GRACE_MS=2000

# Optional. Defaults to <PYTHON_DIR>/../vendor/miner, which is correct
# for a normal `git submodule update --init` checkout. Set it only if
# the vendored miner lives somewhere else.
# MINER_DIR=./vendor/miner

# How many days of point history to keep. Pruned on boot and daily
# after, then VACUUMed when a prune actually removed rows. Defaults to
# 90; 0 disables pruning entirely.
#
# Values under 1 are clamped to 1: the 24h gain figures and the card
# sparklines read the same table, so pruning inside that window would
# erode them.
#
# Only point_snapshots is pruned -- it is the one table that grows on
# every poll. The session tables behind the online/mining time figures
# are never pruned: they are tiny, and dropping rows would corrupt the
# all-time number they exist to answer.
# HISTORY_RETENTION_DAYS=90

# How much the miner writes to its own log file in <DATA_DIR>/logs.
# One of DEBUG, INFO, WARNING, ERROR, CRITICAL. Defaults to INFO.
#
# Upstream defaults this to DEBUG, which logs every websocket keepalive,
# streamer-selection pass and HTTP connection: 99.7% of the lines, and
# 267MB in a single day. Its rotation keeps 7 days, so the total was
# bounded -- at roughly 1.9GB. INFO keeps every mining event, warning and
# error at about 1/300th the size.
#
# Set DEBUG temporarily when diagnosing a miner problem; upstream's GQL
# and connection tracing is genuinely useful, just not to write always.
#
# This is the *file* only. The console stays at INFO because that is what
# the backend captures for the Logs page in the UI, which is unaffected.
#
# The backend reads this in Docker too, but compose passes only
# APP_PASSWORD into the container (see above), so changing the level for
# a Docker deployment means adding it to the `environment:` block in
# compose.yaml as well.
# MINER_LOG_LEVEL=INFO

# ---------------------------------------------------------------------
# Reverse proxy -- only when something else terminates TLS in front
# ---------------------------------------------------------------------
#
# Both default off, which is correct for the documented LAN deployment
# over plain HTTP. Turn them on together, and only when a proxy really
# is in front; see "Putting it behind a reverse proxy" in the README.

# Adds `Secure` to the session cookie, so the browser refuses to send it
# over plain HTTP. Set this whenever the UI is reached over HTTPS --
# without it the cookie minted on the HTTPS origin is still replayed in
# the clear to anything that reaches the app directly on port 8080,
# which is the leak the proxy was meant to close.
#
# Do NOT set it without TLS: the browser silently drops a Secure cookie
# on an HTTP origin, so login appears to succeed and every request after
# it fails with 401.
# SECURE_COOKIE=1

# Makes the backend read the client address from `X-Forwarded-For`
# rather than the socket, which is what the login throttle counts
# against. Behind a proxy without this, every request looks like it
# comes from the proxy, so ten bad guesses lock out everyone at once.
#
# Only set this when a proxy is actually overwriting that header. With
# it on and nothing in front, any caller can forge the header and give
# themselves a fresh throttle bucket per request.
# TRUST_PROXY=1
