# Copy to .env and adjust. .env is gitignored; this file is the tracked
# reference for it.
#
#     cp .env.example .env
#
# Paths are relative to the repository root, which is the working
# directory both `docker compose` and `pnpm dev` run from.

# ---------------------------------------------------------------------
# Shared -- used by `docker compose up` AND `pnpm dev`
# ---------------------------------------------------------------------

# Required. The password that unlocks the web UI. Compose refuses to
# start without it (see compose.yaml), and the backend throws on boot.
APP_PASSWORD=choose-something

# ---------------------------------------------------------------------
# Dev mode only -- `pnpm dev`
#
# Compose passes ONLY APP_PASSWORD into the container (see the
# `environment:` block in compose.yaml), so everything below is ignored
# by Docker. The image sets its own values via ENV in docker/Dockerfile.
# ---------------------------------------------------------------------

# Where config.json, history.db and the cookie pickles are written. Kept
# out of ./data so a dev run never touches the volume Docker mounts.
DATA_DIR=./.devdata

# The Python helpers (state.py, login.py) and the miner entry point.
PYTHON_DIR=./python

# Must be the uv-managed venv, not the system python3 (the default),
# which lacks the miner's dependencies. Create it with `uv sync`.
PYTHON_BIN=./.venv/bin/python

# The built frontend. In dev mode you normally load the Vite dev server
# instead (it proxies /api here), so this only matters if you open the
# backend's port directly after a `pnpm -r build`.
STATIC_ROOT=./apps/frontend/dist

# Backend listen port. Vite's proxy in apps/frontend/vite.config.ts
# targets 8080, so change both together.
PORT=8080

# Optional. Defaults to <PYTHON_DIR>/../vendor/miner, which is correct
# for a normal `git submodule update --init` checkout. Set it only if
# the vendored miner lives somewhere else.
# MINER_DIR=./vendor/miner
