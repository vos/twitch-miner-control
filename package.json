{
  "name": "twitch-miner-control",
  "version": "1.6.1",
  "private": true,
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vos/twitch-miner-control.git"
  },
  "homepage": "https://github.com/vos/twitch-miner-control#readme",
  "bugs": "https://github.com/vos/twitch-miner-control/issues",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec",
  "scripts": {
    "predev": "pnpm run build:backend",
    "dev": "concurrently --kill-others --names tsc,server,web --prefix-colors blue,green,magenta \"pnpm run dev:tsc\" \"pnpm run dev:node\" \"pnpm run dev:web\"",
    "dev:tsc": "pnpm run build:backend --watch --preserveWatchOutput",
    "dev:node": "node --watch --watch-preserve-output --env-file=.env apps/backend/dist/index.js",
    "dev:web": "pnpm --filter @app/frontend dev",
    "build": "pnpm -r build",
    "build:backend": "tsc -p apps/backend/tsconfig.json",
    "test": "pnpm -r test",
    "prepreview": "pnpm run build",
    "preview": "STATIC_ROOT=./apps/frontend/dist node --env-file=.env apps/backend/dist/index.js",
    "start": "node --env-file=.env apps/backend/dist/index.js"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "typescript": "^7.0.2"
  }
}
